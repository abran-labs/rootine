{
  "name": "rootine",
  "version": "0.1.0",
  "description": "Linux-only thin polkit wrapper: one px command, one polkit rule, one agent prompt. Pick always-allow, review, or always-ask.",
  "type": "module",
  "bin": {
    "rootine": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=esm --outdir dist",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "test": "bun test",
    "prepublishOnly": "bun run check"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT"
}
