{
  "name": "rootine",
  "version": "0.1.5",
  "description": "Linux-only thin polkit wrapper: one px command, one polkit rule, one agent prompt. Pick always-allow, review, or always-ask.",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=esm --outdir dist",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "test": "bun test",
    "release": "sh scripts/build-release.sh",
    "smoke:install": "sh scripts/smoke-install.sh"
  },
  "dependencies": {
    "@abran-labs/onboard-kit": "0.3.7",
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT"
}
